DATABASE_URL=postgres://localhost/clickman
CLICKMAN_ADMIN_TOKEN=
CLICKMAN_BIND=127.0.0.1:4132
CLICKMAN_DATABASE_POOL=10
CLICKMAN_WEB_DIR=apps/web/dist
CLICKMAN_MAINTENANCE_CRON=0 * * * * *
CLICKMAN_TRUST_PROXY_HEADERS=0
RUST_LOG=clickman=info,tower_http=info
# Analytics storage: postgres (one database) or clickhouse (PostgreSQL inbox + native analytics).
CLICKMAN_ANALYTICS_BACKEND=postgres
# Required only for the clickhouse backend; credentials belong to API and worker operators.
CLICKMAN_CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKMAN_CLICKHOUSE_DATABASE=clickman
CLICKMAN_CLICKHOUSE_USER=default
CLICKMAN_CLICKHOUSE_PASSWORD=
# Optional local stdio MCP process; credentials belong only to its private environment.
CLICKMAN_MCP_GRAPHQL_ENDPOINT=http://127.0.0.1:4132/graphql
CLICKMAN_MCP_TOKEN=
CLICKMAN_MCP_ALLOW_WRITES=0
# Session-only hosts use COOKIE + exact public ORIGIN instead of TOKEN.
# CLICKMAN_MCP_COOKIE=
# CLICKMAN_MCP_ORIGIN=http://127.0.0.1:4133
